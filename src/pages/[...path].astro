---
// Every localised page, rendered per request from EmDash:
//   /es, /es/receta/:slug, /es/categoria/:name, /es/:page and the /en equivalents
import Layout from '../layouts/Layout.astro'
import Recipe from '../components/molecules/Recipe.astro'
import RecipePreviewList from '../components/molecules/RecipePreviewList.astro'
import RecipesCategory from '../components/templates/RecipesCategory.astro'
import LandingPage from '../components/templates/LandingPage.astro'
import { PortableText } from 'emdash/ui'
import { LOCALES, t, type Locale } from '../i18n'
import {
	alternates,
	categoryAlternates,
	categorySegment,
	getAllPages,
	getAllRecipes,
	recipeSegment,
	translationAlternates
} from '../data/recipes'

const [locale, segment, slug, ...rest] = (Astro.params.path ?? '').split('/') as [
	Locale,
	...string[]
]
if (!LOCALES.includes(locale) || rest.length) return Astro.rewrite('/404')

const all = await getAllRecipes()
const recipes = all[locale]

// /:locale/:page → a `pages` entry (About…)
const allPages = segment && !slug ? await getAllPages() : undefined
const page = allPages?.[locale].find((p) => p.slug === segment)
if (allPages && !page) return Astro.rewrite('/404')

const recipe = segment === recipeSegment(locale) ? recipes.find((r) => r.slug === slug) : undefined
// ponytail: first 3 sharing any category; add ranking/shuffle if the catalogue grows
const related = recipe
	? recipes
			.filter((r) => r !== recipe && r.category.some((c) => recipe.category.includes(c)))
			.slice(0, 3)
	: []
const category = segment === categorySegment(locale) ? slug : undefined
const items = category ? recipes.filter((r) => r.category.includes(category)) : []

if (segment && !page && !recipe && !items.length) return Astro.rewrite('/404')
---

{page && allPages ? (
	<Layout
		locale={locale}
		recipes={recipes}
		alternates={translationAlternates(allPages, page)}
		title={page.title}
	>
		<h1>{page.title}</h1>
		<div class="md">
			<PortableText value={page.body} />
		</div>
	</Layout>
) : recipe ? (
	<Layout
		locale={locale}
		recipes={recipes}
		alternates={translationAlternates(all, recipe)}
		title={recipe.title}
		activeCategory={recipe.category[0]}
	>
		<Recipe recipe={recipe} locale={locale} />
		{related.length > 0 && (
			<>
				<h2>{t(locale, 'components.recipe.related')}</h2>
				<RecipePreviewList items={related} />
			</>
		)}
	</Layout>
) : category ? (
	<Layout
		locale={locale}
		recipes={recipes}
		alternates={categoryAlternates(all, locale, category)}
		title={category}
		activeCategory={category}
	>
		<RecipesCategory locale={locale} category={category} items={items} />
	</Layout>
) : (
	<Layout locale={locale} recipes={recipes} alternates={alternates(() => undefined)}>
		<LandingPage locale={locale} recipes={recipes} />
	</Layout>
)}
