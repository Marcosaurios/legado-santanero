---
import '../styles/global.scss'
import Navbar from '../components/organisms/Navbar.astro'
import Categories from '../components/molecules/Categories.astro'
import SearchList from '../components/organisms/SearchList.astro'
import { t, type Locale } from '../i18n'
import type { Recipe } from '../types'

interface Props {
	locale: Locale
	recipes: Recipe[]
	alternates: Record<Locale, string>
	title?: string
	activeCategory?: string
}
const { locale, recipes, alternates, title, activeCategory } = Astro.props
const siteTitle = t(locale, 'components.navbar.title')
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap"
		/>
		<title>{title ? `${title} | ${siteTitle}` : siteTitle}</title>
	</head>
	<body>
		<Navbar locale={locale} alternates={alternates} />
		<main>
			<Categories locale={locale} recipes={recipes} active={activeCategory} />
			<SearchList locale={locale} recipes={recipes} />
			<div id="page-content">
				<slot />
			</div>
		</main>
	</body>
</html>

<style lang="scss">
	@use '../styles/vars' as *;

	main {
		padding: 4rem 1rem 5rem 1rem;

		@include desktopView() {
			padding: 0 1rem 1rem 1rem;
		}
	}
</style>
