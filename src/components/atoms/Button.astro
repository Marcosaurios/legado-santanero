---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'button'> & HTMLAttributes<'a'> & { label?: string }
const { href, label, class: className, ...rest } = Astro.props
const Tag = href ? 'a' : 'button'
---

<Tag href={href} class:list={['Button', className]} {...rest}>
	<slot />
	{label && <span class="label">{label}</span>}
</Tag>

<style lang="scss">
	@use '../../styles/vars' as *;

	.Button {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 3px;
		padding: 1em;
		cursor: pointer;

		// Reset <a>/<button> defaults
		color: $fontColor;
		text-decoration: none;
		background: none;
		border: none;
		font-family: $font;
		font-size: $fontSize;
	}
</style>
