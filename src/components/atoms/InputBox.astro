---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'input'> & {
	/** Focus the input when the component that hides it reveals it (see Navbar's mobile search) */
	focusOnReveal?: boolean
}
const { focusOnReveal, ...rest } = Astro.props
---

<div class="InputBox">
	<input
		type="text"
		autocomplete="off"
		data-focus-on-reveal={focusOnReveal ? '' : undefined}
		{...rest}
	/>
</div>

<style lang="scss">
	@use '../../styles/vars' as *;

	$border: 2px;
	.InputBox {
		box-sizing: border-box;
		position: relative;
		padding: 4px;

		input {
			box-sizing: border-box;
			width: 100%;
			height: 2rem;
			border-radius: 20px;

			font-family: $font;
			font-style: italic;
			font-size: 1rem;
			text-indent: 16px;
			// CSS reset
			outline: none;

			border: $border solid $fontColor;

			background: linear-gradient(to left, transparent 50%, $fontColor 50%) right;
			background-size: 210%;
			background-color: transparent;
			transition: 0.15s cubic-bezier(0.165, 0.84, 0.44, 1);
			&:focus {
				background-position: left;
			}
			&:not(:focus) {
				color: $fontColor;
			}
		}
	}
</style>
