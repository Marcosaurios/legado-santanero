---
import { Image } from 'emdash/ui'
import Clock from '~icons/fa7-solid/clock'
import type { Recipe } from '../../types'
import { formatDuration } from '../utils'

interface Props {
	recipe: Recipe
}
const { recipe } = Astro.props
---

<div class="RecipePreview">
	<a href={recipe.url} class="link">
		<Image image={recipe.imageMain} alt="" />
		<span class="title">{recipe.title}</span>

		<span class="extra">
			<Clock />
			<span>{recipe.minutes && formatDuration(recipe.minutes)}</span>
		</span>
	</a>
</div>

<style lang="scss">
	@use '../../styles/vars' as *;

	.RecipePreview {
		padding-top: 15px;
	}

	.link {
		display: flex;
		align-items: center;
		height: 140px;
		@include desktopView() {
			height: 16rem;
		}
		border-radius: 10px;

		// The image fills the card behind the text and zooms inside its rounded box
		position: relative;
		isolation: isolate;
		overflow: hidden;

		// Inherited by the title and duration. line-height 1 so the text centers on the
		// card's middle (the global line-height is shorter than the title on mobile)
		color: $fontColor;
		line-height: 1;
		text-decoration: none;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6); // readable on light photos

		filter: saturate(0.8);
		transition: 0.3s ease-in-out;

		&:hover {
			filter: none;
			transform: scale(1.02);
		}
	}

	// Rendered by EmDash's Image (child component), hence :global
	.link :global(img) {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease-in-out;
	}

	.link:hover :global(img) {
		transform: scale(1.1);
	}

	.title {
		flex-grow: 1;
		padding-left: 1rem;
		font-size: 1.5rem;
	}

	.extra {
		display: flex;
		align-items: center;
		gap: 5px;
		width: 8rem;
		filter: grayscale(0.3);

		:global(svg) {
			display: block;
			filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.6)); // text-shadow skips SVGs
		}
	}
</style>
