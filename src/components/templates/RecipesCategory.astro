---
import RecipePreviewList from '../molecules/RecipePreviewList.astro'
import type { Recipe } from '../../types'
import { t, type Locale } from '../../i18n'

interface Props {
	locale: Locale
	category: string
	items: Recipe[]
}
const { locale, category, items } = Astro.props
---

<h2>{[t(locale, 'templates.category.title'), category].join(' ')}</h2>
<RecipePreviewList items={items} />
