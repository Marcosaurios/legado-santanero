{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "legado-santanero",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{ "pattern": "legadosantanero.es", "custom_domain": true },
		{ "pattern": "www.legadosantanero.es", "custom_domain": true }
	],
	// Recipes and admin data
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "legado-santanero",
			"database_id": "a8420fb9-4f00-488f-9841-9ca136c3475a"
		}
	],
	// Uploaded images
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "legado-santanero-media" }],
	// Sandboxed plugins need Worker Loader (Workers paid plan). Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// EmDash maintenance and scheduled publishing
	"triggers": { "crons": ["* * * * *"] }
}
