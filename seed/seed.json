					"translatable": false,
					"validation": {
						"subFields": [
							{
								"slug": "image",
								"type": "image",
								"label": "Imagen"
							}
						]
					}
				},
				{
					"slug": "minutes",
					"label": "Minutos",
					"type": "integer",
					"translatable": false,
					"validation": {
						"min": 1
					}
				},
				{
					"slug": "difficulty",
					"label": "Dificultad (1-5)",
					"type": "integer",
					"translatable": false,
					"validation": {
						"min": 1,
						"max": 5
